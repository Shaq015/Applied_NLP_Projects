    "def build_pos_random_forest_model() -> Pipeline:\n",
    "    \"\"\"Build a Random Forest model using POS and simple grammar features.\n",
    "    This model intentionally ignores raw words and focuses on syntactic writing patterns, so it would be different from the TF-IDF content models.\n",
    "    \"\"\"\n",
    "    return Pipeline([\n",
    "        # Transform each tweet into a POS/grammar pseudo-document\n",
    "        (\"pos_grammar\", PosGrammarTransformer()),\n",
    "\n",
    "        # Vectorize POS patterns similarly to text features\n",
    "        (\"tfidf\", TfidfVectorizer(\n",
    "            ngram_range=(1, 2),\n",
    "            min_df=1,\n",
    "            max_features=6000,\n",
    "            sublinear_tf=True\n",
    "        )),\n",
    "\n",
    "        (\"clf\", RandomForestClassifier(\n",
    "            n_estimators=350,\n",
    "            max_depth=None,\n",
    "            min_samples_leaf=2,\n",
    "            class_weight=\"balanced_subsample\",\n",
    "            random_state=SEED,\n",
    "            n_jobs=-1\n",
    "        )),\n",
    "    ])"
   ]
