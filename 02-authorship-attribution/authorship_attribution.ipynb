    "# Shared validation and reporting - all comparable models use the same validation split strategy\n",
    "\n",
    "def get_cv() -> StratifiedKFold:\n",
    "    \"\"\"Return the validation split used for all comparable model evaluations.\"\"\"\n",
    "    return StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "\n",
    "\n",
    "def evaluate_sklearn_model(model, X: pd.DataFrame, y: np.ndarray, model_name: str) -> Dict[str, float]:\n",
    "    \"\"\"Evaluate an sklearn-style model using 5-fold stratified cross validation.\"\"\"\n",
    "    scoring = {\n",
    "        \"accuracy\": \"accuracy\",\n",
    "        \"precision\": \"precision\",\n",
    "        \"recall\": \"recall\",\n",
    "        \"f1\": \"f1\",\n",
    "    }\n",
    "\n",
    "    scores = cross_validate(\n",
    "        model,\n",
    "        X,\n",
    "        y,\n",
    "        cv=get_cv(),\n",
    "        scoring=scoring,\n",
    "        n_jobs=-1,\n",
    "        error_score=\"raise\"\n",
    "    )\n",
    "\n",
    "    # Store mean/std to compare in the report\n",
    "    row = {\"model\": model_name}\n",
    "    for metric in scoring:\n",
    "        values = scores[f\"test_{metric}\"]\n",
    "        row[f\"{metric}_mean\"] = float(np.mean(values))\n",
    "        row[f\"{metric}_std\"] = float(np.std(values))\n",
    "\n",
    "    return row\n",
    "\n",
    "\n",
    "def print_holdout_report(model, X: pd.DataFrame, y: np.ndarray, title: str = \"Holdout report\"):\n",
    "    \"\"\"Print a quick train/validation report for sanity checking one model.\"\"\"\n",
    "    X_train, X_val, y_train, y_val = train_test_split(\n",
    "        X,\n",
    "        y,\n",
    "        test_size=0.2,\n",
    "        random_state=SEED,\n",
    "        stratify=y\n",
    "    )\n",
    "\n",
    "    model.fit(X_train, y_train)\n",
    "    preds = model.predict(X_val)\n",
    "\n",
    "    print(title)\n",
    "    print(classification_report(y_val, preds, digits=4))\n",
    "    print(\"Confusion matrix:\")\n",
    "    print(confusion_matrix(y_val, preds))"
   ]
  },
