   "source": [
    "def build_hybrid_rbf_svc_model() -> Pipeline:\n",
    "    \"\"\"Build a nonlinear SVM using an RBF kernel.\n",
    "    This model uses nonlinear SVM and combines multiple feature types.\n",
    "    \"\"\"\n",
    "    features = FeatureUnion([\n",
    "        (\"word_tfidf\", Pipeline([\n",
    "            (\"select_text\", TextSelector(\"clean_text\")),\n",
    "            (\"tfidf\", TfidfVectorizer(\n",
    "                ngram_range=(1, 2),\n",
    "                min_df=2,\n",
    "                max_features=6000,\n",
    "                sublinear_tf=True\n",
    "            )),\n",
    "        ])),\n",
    "\n",
    "        (\"char_tfidf\", Pipeline([\n",
    "            (\"select_text\", TextSelector(\"clean_text\")),\n",
    "            (\"tfidf\", TfidfVectorizer(\n",
    "                analyzer=\"char_wb\",\n",
    "                ngram_range=(3, 5),\n",
    "                min_df=2,\n",
    "                max_features=4000\n",
    "            )),\n",
    "        ])),\n",
    "\n",
    "        (\"pos_features\", Pipeline([\n",
    "            # Reuse the POS/grammar transformer from classifier 4\n",
    "            (\"pos_grammar\", PosGrammarTransformer()),\n",
    "            (\"tfidf\", TfidfVectorizer(\n",
    "                ngram_range=(1, 2),\n",
    "                min_df=1,\n",
    "                max_features=2500,\n",
    "                sublinear_tf=True\n",
    "            )),\n",
    "        ])),\n",
    "\n",
    "        (\"style_time\", Pipeline([\n",
    "            # Numeric style features have different scales, so I standardize them\n",
    "            (\"style\", NumericStyleFeatures()),\n",
    "            (\"scale\", StandardScaler(with_mean=False)),\n",
    "        ])),\n",
    "    ])\n",
    "\n",
    "    return Pipeline([\n",
    "        (\"features\", features),\n",
    "        (\"clf\", SVC(\n",
    "            kernel=\"rbf\",              # Nonlinear SVM setting\n",
    "            C=10.0,                    # Slightly larger C allows a more flexible boundary\n",
    "            gamma=\"scale\",\n",
    "            class_weight=\"balanced\",\n",
    "            random_state=SEED\n",
    "        )),\n",
    "    ])"
   ]
  },
