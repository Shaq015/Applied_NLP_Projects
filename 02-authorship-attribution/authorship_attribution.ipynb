    "def build_linear_svc_model() -> Pipeline:\n",
    "    \"\"\"Build the linear SVM baseline.\n",
    "    This model is used to compare against the nonlinear RBF-kernel SVM implemented later in the notebook.\n",
    "    \"\"\"\n",
