    "def run_all_experiments(train_fn: str = TRAIN_FILE) -> pd.DataFrame:\n",
    "    \"\"\"Run validation for all selected classifiers and return a results table.\"\"\"\n",
    "    # Read, filter and preprocess the training data once\n",
    "    train_df = prepare_dataframe(read_train_tsv(train_fn))\n",
    "    X = train_df\n",
    "    y = train_df[\"label\"].values\n",
    "\n",
    "    results = []\n",
    "\n",
    "    results.append(evaluate_sklearn_model(build_logistic_regression_model(), X, y, \"Logistic Regression\"))\n",
    "    results.append(evaluate_sklearn_model(build_linear_svc_model(), X, y, \"Linear SVM\"))\n",
    "    results.append(cross_validate_ffnn(X, y, epochs=5))\n",
    "    results.append(evaluate_sklearn_model(build_pos_random_forest_model(), X, y, \"POS Random Forest\"))\n",
    "    results.append(evaluate_sklearn_model(build_hybrid_rbf_svc_model(), X, y, \"Hybrid RBF SVC\"))\n",
    "    results.append(cross_validate_bertweet(X, y, epochs=3, n_splits=5))\n",
    "\n",
    "    # Sort by F1 because it balances precision and recall\n",
    "    results_df = pd.DataFrame(results).sort_values(\"f1_mean\", ascending=False)\n",
    "    display(results_df)\n",
    "    return results_df\n",
    "\n",
    "\n",
    "results_df = run_all_experiments(\"/content/trump_train.tsv\")"
   ]
  },
