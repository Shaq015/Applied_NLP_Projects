    "def build_logistic_regression_model() -> Pipeline:\n",
    "    \"\"\"Build Logistic Regression on word and character TF-IDF features.\"\"\"\n",
    "    # FeatureUnion concatenates several feature representations into one matrix, here I combine word n-grams and character n-grams\n",
    "    features = FeatureUnion([\n",
    "        (\"word_tfidf\", Pipeline([\n",
    "            (\"select_text\", TextSelector(\"clean_text\")),\n",
    "\n",
    "            # Word TF-IDF captures content words and short phrases\n",
    "            (\"tfidf\", TfidfVectorizer(\n",
    "                ngram_range=(1, 2),      # unigrams + bigrams\n",
    "                min_df=2,                # ignore terms that appear only once\n",
    "                max_features=8000,       # keep the feature space reasonable\n",
    "                sublinear_tf=True\n",
    "            )),\n",
    "        ])),\n",
    "        (\"char_tfidf\", Pipeline([\n",
    "            (\"select_text\", TextSelector(\"clean_text\")),\n",
    "            (\"tfidf\", TfidfVectorizer(\n",
    "                analyzer=\"char_wb\",\n",
    "                ngram_range=(3, 5),\n",
    "                min_df=2,\n",
    "                max_features=5000\n",
    "            )),\n",
    "        ])),\n",
    "    ])\n",
    "\n",
    "    return Pipeline([\n",
    "        (\"features\", features),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            max_iter=2000,\n",
    "            C=2.0,\n",
    "            class_weight=\"balanced\",\n",
    "            random_state=SEED\n",
    "        )),\n",
    "    ])"
   ]
  },
