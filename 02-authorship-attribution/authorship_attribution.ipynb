    "# Feature engineering classes\n",
    "\n",
    "class TextSelector(BaseEstimator, TransformerMixin):\n",
    "    \"\"\"Select a single text column from a pandas DataFrame inside sklearn pipelines.\"\"\"\n",
    "\n",
    "    def __init__(self, column: str):\n",
    "        self.column = column\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        return X[self.column].astype(str).values\n",
    "\n",
    "\n",
    "class NumericStyleFeatures(BaseEstimator, TransformerMixin):\n",
    "    \"\"\"Extract simple numeric style and time features from tweets.\n",
    "    These features are added because Authorship differences may appear not only in word choice, but also in writing style, punctuation patterns, capitalization, and posting behavior.\n",
    "    \"\"\"\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        rows = []\n",
    "        for _, row in X.iterrows():\n",
    "            text = str(row.get(\"text\", \"\"))\n",
    "            clean_text = str(row.get(\"clean_text\", text))\n",
    "            words = clean_text.split()\n",
    "            dt = row.get(\"timestamp_dt\", pd.NaT)\n",
    "\n",
    "            # Basic length information, for capturing short/long tweet habits\n",
    "            n_chars = len(text)\n",
    "            n_words = len(words)\n",
    "            n_letters = sum(ch.isalpha() for ch in text)\n",
    "            n_upper = sum(ch.isupper() for ch in text)\n",
    "\n",
    "            # If timestamp parsing failed, use zero values instead of crashing\n",
    "            hour = 0 if pd.isna(dt) else int(dt.hour)\n",
    "            day_of_week = 0 if pd.isna(dt) else int(dt.dayofweek)\n",
    "\n",
    "            # Capture sequences of !\n",
    "            max_exclamation_run = max([len(x) for x in re.findall(r\"!+\", text)] + [0])\n",
    "\n",
    "            # Capture number of capitalized words\n",
    "            n_all_caps_words = sum(1 for w in words if len(w) > 1 and w.isupper())\n",
    "\n",
    "            # Add one numeric feature vector per tweet\n",
    "            rows.append([\n",
    "                n_chars,\n",
    "                n_words,\n",
    "                np.mean([len(w) for w in words]) if words else 0,\n",
    "                text.count(\"!\"),\n",
    "                max_exclamation_run,\n",
    "                text.count(\"?\"),\n",
    "                text.count(\".\"),\n",
    "                n_all_caps_words,\n",
    "                len(re.findall(r\"#\\w+\", text)),\n",
    "                len(re.findall(r\"@\\w+\", text)),\n",
    "                len(re.findall(r\"https?://\\S+|www\\.\\S+\", text)),\n",
    "                n_upper / max(n_letters, 1),\n",
    "                int(text.isupper()),\n",
    "                hour,\n",
    "                day_of_week,\n",
    "                int(hour < 6 or hour >= 22),\n",
    "            ])\n",
    "\n",
    "        return np.asarray(rows, dtype=float)\n",
    "\n",
    "\n",
    "class PosGrammarTransformer(BaseEstimator, TransformerMixin):\n",
    "    \"\"\"Convert tweets into POS/grammar strings for syntactic feature extraction.\n",
    "\n",
    "    For each tweet, I create a pseudo-document made of:\n",
    "    - POS unigrams\n",
    "    - POS bigrams\n",
    "    - POS trigrams\n",
    "    - A few simple hand-written grammar patterns\n",
    "    \"\"\"\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def _safe_pos_tags(self, text: str) -> List[str]:\n",
    "        \"\"\"Tokenize and POS-tag a tweet, returning only POS tag labels.\"\"\"\n",
    "        try:\n",
    "            tokens = word_tokenize(str(text))\n",
    "\n",
    "            # Very short/empty tweets should simply return an empty POS list\n",
    "            if not tokens:\n",
    "                return []\n",
    "\n",
    "            # Keep only the tag from (word, tag) pairs\n",
    "            return [tag for _, tag in pos_tag(tokens)]\n",
    "        except Exception:\n",
    "            # In case NLTK has a resource issue in a runtime, do not break the whole notebook\n",
    "            return []\n",
    "\n",
    "    def _grammar_markers(self, tags: List[str]) -> List[str]:\n",
    "        \"\"\"Create simple grammatical pattern indicators from a POS tag list.\"\"\"\n",
    "        markers = []\n",
    "\n",
    "        if any(t.startswith(\"VB\") for t in tags):\n",
    "            markers.append(\"HAS_VERB\")\n",
    "        if any(t.startswith(\"NNP\") for t in tags):\n",
    "            markers.append(\"HAS_PROPER_NOUN\")\n",
    "        if any(t.startswith(\"JJ\") for t in tags):\n",
    "            markers.append(\"HAS_ADJECTIVE\")\n",
    "        if len(tags) >= 2 and tags[0].startswith(\"UH\"):\n",
    "            markers.append(\"STARTS_WITH_INTERJECTION\")\n",
    "        if tags.count(\"NNP\") >= 2:\n",
    "            markers.append(\"MULTIPLE_PROPER_NOUNS\")\n",
    "        if any(t in {\"PRP\", \"PRP$\"} for t in tags):\n",
    "            markers.append(\"HAS_PRONOUN\")\n",
    "\n",
    "        return markers\n",
    "\n",
    "    def transform(self, X):\n",
    "        docs = []\n",
    "\n",
    "        # The transformer may receive either a DataFrame or directly a list/array of strings\n",
    "        texts = X[\"clean_text\"].astype(str).tolist() if isinstance(X, pd.DataFrame) else list(X)\n",
    "\n",
    "        for text in texts:\n",
    "            tags = self._safe_pos_tags(text)\n",
    "\n",
    "            # POS unigrams are the individual tags\n",
    "            unigrams = tags\n",
    "\n",
    "            # POS bigrams and trigrams capture local syntax patterns\n",
    "            bigrams = [f\"{tags[i]}_{tags[i+1]}\" for i in range(len(tags) - 1)]\n",
    "            trigrams = [f\"{tags[i]}_{tags[i+1]}_{tags[i+2]}\" for i in range(len(tags) - 2)]\n",
    "\n",
    "            # Hand-written grammar markers add a few higher-level syntactic signals\n",
    "            markers = self._grammar_markers(tags)\n",
    "\n",
    "            # Turn the syntactic features into one string so TfidfVectorizer can handle it\n",
    "            docs.append(\" \".join(unigrams + bigrams + trigrams + markers))\n",
    "\n",
    "        return docs"
   ]
  },
