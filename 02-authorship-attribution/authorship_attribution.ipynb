    "# Data loading and basic preprocessing\n",
    "\n",
    "def read_train_tsv(train_fn: str) -> pd.DataFrame:\n",
    "    \"\"\"Read the labeled training TSV file and create the binary authorship label.\n",
    "    The task is authorship attribution inside Trump's personal Twitter account.\n",
    "\n",
    "    According to the assignment assumption:\n",
    "    android = Trump himself = label 0\n",
    "    iphone = staffer = label 1\n",
    "    \"\"\"\n",
    "    df = pd.read_csv(\n",
    "        train_fn,\n",
    "        sep=\"\\t\",\n",
    "        header=None,\n",
    "        names=[\"tweet_id\", \"handle\", \"text\", \"timestamp\", \"device\"],\n",
    "        quoting=csv.QUOTE_NONE,\n",
    "        keep_default_na=False,\n",
    "        on_bad_lines=\"skip\"\n",
    "    )\n",
    "\n",
    "    # Normalize the handle and device columns before filtering\n",
    "    df[\"handle_norm\"] = df[\"handle\"].astype(str).str.strip()\n",
    "    df[\"device_norm\"] = df[\"device\"].astype(str).str.lower().str.strip()\n",
    "\n",
    "    df = df[df[\"handle_norm\"] == \"realDonaldTrump\"].copy()\n",
    "\n",
    "    label_map = {\n",
    "        \"android\": 0,  # Trump himself\n",
    "        \"iphone\": 1    # Staffer\n",
    "    }\n",
    "\n",
    "    df = df[df[\"device_norm\"].isin(label_map)].copy()\n",
    "\n",
    "    # Create the binary target column used by all supervised classifiers\n",
    "    df[\"label\"] = df[\"device_norm\"].map(label_map).astype(int)\n",
    "\n",
    "    # Timestamp parsing is useful later for time-based features such as hour of day, day of week, and night/day indicators\n",
    "    df[\"timestamp_dt\"] = pd.to_datetime(\n",
    "        df[\"timestamp\"],\n",
    "        format=\"%Y-%m-%d %H:%M:%S\",\n",
    "        errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    # Reset the index after filtering so later splits and iloc operations are easier to debug and follow\n",
    "    return df.reset_index(drop=True)\n",
    "\n",
    "\n",
    "def read_test_tsv(test_fn: str) -> pd.DataFrame:\n",
    "    \"\"\"Read the unlabeled test TSV file.\n",
    "    The provided test file contains only:\n",
    "    handle, text, timestamp.\n",
    "\n",
    "    The model should output one prediction per test tweet:\n",
    "    0 = Trump, 1 = staffer.\n",
    "    \"\"\"\n",
    "    df = pd.read_csv(\n",
    "        test_fn,\n",
    "        sep=\"\\t\",\n",
    "        header=None,\n",
    "        names=[\"handle\", \"text\", \"timestamp\"],\n",
    "        quoting=csv.QUOTE_NONE,\n",
    "        keep_default_na=False,\n",
    "        on_bad_lines=\"skip\"\n",
    "    )\n",
    "\n",
    "    # Keep a normalized handle column for sanity checks, I do not use it as a predictive feature\n",
    "    df[\"handle_norm\"] = df[\"handle\"].astype(str).str.strip()\n",
    "\n",
    "    # Parse timestamps so the same feature extraction code can be applied to both train and test data\n",
    "    df[\"timestamp_dt\"] = pd.to_datetime(\n",
    "        df[\"timestamp\"],\n",
    "        format=\"%Y-%m-%d %H:%M:%S\",\n",
    "        errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    return df.reset_index(drop=True)\n",
    "\n",
    "\n",
    "def preprocess_text(text: str) -> str:\n",
    "    \"\"\"Apply light tweet preprocessing while keeping stylistic information.\n",
    "\n",
    "    I intentionally avoid lowercasing because capitalization can be meaningful for authorship attribution.\n",
    "    I also keep punctuation because exclamation marks, question marks, and repeated punctuation may indicate writing style.\n",
    "    \"\"\"\n",
    "    text = str(text)\n",
    "\n",
    "    # Replace URLs with a stable token instead of deleting them.\n",
    "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \" URL \", text)\n",
    "\n",
    "    # Replace @mentions with a stable token, because the exact username may cause overfitting, but mentioning someone is useful\n",
    "    text = re.sub(r\"@\\w+\", \" USER \", text)\n",
    "\n",
    "    # I keep hashtags as text because hashtags may carry both content and style\n",
    "\n",
    "    # Collapse repeated spaces after the URL/user replacements\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "\n",
    "def prepare_dataframe(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Add preprocessing columns shared by all models.\n",
    "    This function keeps the original text and adds a cleaned version.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    # clean_text is the main text field used by most classifiers, the original text column is kept also\n",
    "    df[\"clean_text\"] = df[\"text\"].apply(preprocess_text)\n",
    "\n",
    "    # Make sure timestamp_dt exists even if this function receives a dataframe that was not created by read_train_tsv/read_test_tsv.\n",
    "    if \"timestamp_dt\" not in df.columns:\n",
    "        df[\"timestamp_dt\"] = pd.to_datetime(\n",
    "            df.get(\"timestamp\", \"\"),\n",
    "            format=\"%Y-%m-%d %H:%M:%S\",\n",
    "            errors=\"coerce\"\n",
    "        )\n",
    "\n",
    "    return df"
   ]
