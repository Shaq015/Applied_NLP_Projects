   "source": [
    "def predict(m, fn):\n",
    "  \"\"\" Returns a list of 0s and 1s, corresponding to the lines in the specified file.\n",
    "\n",
    "    Args:\n",
    "      m: the trained model to be used.\n",
    "      fn: the full path to a file in the same format as the test set we have proveded.\n",
    "  \"\"\"\n",
    "  test_df = read_test_tsv(fn)\n",
    "\n",
    "  # Apply the exact same preprocessing used during training\n",
    "  test_df = prepare_dataframe(test_df)\n",
    "  res = m.predict(test_df)\n",
    "\n",
    "  # Return a list containing the predictions\n",
    "  return [int(x) for x in res]"
   ]
  },
