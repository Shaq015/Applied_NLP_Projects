    "def write_predictions_file(preds: List[int], out_fn: str) -> None:\n",
    "    \"\"\"Write predictions as one space-separated line of 0/1 labels.\"\"\"\n",
    "    with open(out_fn, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(\" \".join(str(int(p)) for p in preds))\n",
    "\n",
    "\n",
    "final_model = retrain_best_model(\"/content/trump_train.tsv\")\n",
    "final_predictions = predict(final_model, \"/content/trump_tweets_test_a.tsv\")\n",
    "write_predictions_file(final_predictions, \"/content/authorship_predictions.txt\")\n",
    "\n",
    "print(\"Number of predictions:\", len(final_predictions))\n",
    "print(final_predictions[:20])\n",
    "print(\"Unique labels:\", set(final_predictions))"
   ]
