   },
   "source": [
    "## Classifier 6 - BERTweet fine-tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "ccd82b59",
   "metadata": {
    "id": "ccd82b59"
   },
   "outputs": [],
   "source": [
    "@dataclass\n",
    "class BertweetModelWrapper:\n",
    "    \"\"\"Prediction wrapper for the fine-tuned BERTweet model.\"\"\"\n",
    "    tokenizer: Any\n",
    "    model: Any\n",
    "    device: torch.device\n",
    "    max_length: int = 128\n",
    "\n",
    "    def predict(self, X: pd.DataFrame) -> np.ndarray:\n",
    "        texts = X[\"clean_text\"].astype(str).tolist()\n",
    "\n",
    "        self.model.to(self.device)\n",
    "        self.model.eval()\n",
    "        preds = []\n",
    "        batch_size = 32\n",
    "\n",
    "        for start in range(0, len(texts), batch_size):\n",
    "            batch_texts = texts[start:start + batch_size]\n",
    "\n",
    "            # Tokenize and pad the current batch\n",
    "            enc = self.tokenizer(\n",
    "                batch_texts,\n",
    "                truncation=True,\n",
    "                padding=True,\n",
    "                max_length=self.max_length,\n",
    "                return_tensors=\"pt\"\n",
    "            )\n",
    "\n",
    "            # Move token tensors to the same device as the model\n",
    "            enc = {k: v.to(self.device) for k, v in enc.items()}\n",
    "\n",
    "            with torch.no_grad():\n",
    "                logits = self.model(**enc).logits\n",
    "                batch_preds = torch.argmax(logits, dim=1).cpu().numpy().tolist()\n",
    "\n",
    "            preds.extend(batch_preds)\n",
    "\n",
    "        return np.array(preds, dtype=int)\n",
    "\n",
    "\n",
    "def train_bertweet_model(X: pd.DataFrame, y: np.ndarray, X_val: pd.DataFrame = None, y_val: np.ndarray = None, epochs: int = 3, max_length: int = 128) -> BertweetModelWrapper:\n",
    "    \"\"\"Fine-tune BERTweet on the authorship attribution data.\"\"\"\n",
    "    model_name = \"vinai/bertweet-base\"\n",
    "    tokenizer = AutoTokenizer.from_pretrained(model_name, normalization=True, use_fast=False)\n",
    "\n",
    "    # num_labels=2 because the task is binary: Trump=0, staffer=1\n",
    "    model = AutoModelForSequenceClassification.from_pretrained(model_name, num_labels=2)\n",
    "    model.to(device)\n",
    "\n",
    "    hf_df = pd.DataFrame({\n",
    "        \"text\": X[\"clean_text\"].astype(str).tolist(),\n",
    "        \"label\": y.astype(int).tolist(),\n",
    "    })\n",
    "\n",
    "    dataset = HFDataset.from_pandas(hf_df)\n",
    "\n",
    "    def tokenize_batch(batch):\n",
    "        return tokenizer(batch[\"text\"], truncation=True, max_length=max_length)\n",
    "\n",
    "    tokenized = dataset.map(tokenize_batch, batched=True)\n",
    "    tokenized = tokenized.remove_columns([\"text\"])\n",
    "\n",
    "    eval_tokenized = None\n",
    "\n",
    "    if X_val is not None and y_val is not None:\n",
    "        val_hf_df = pd.DataFrame({\n",
    "            \"text\": X_val[\"clean_text\"].astype(str).tolist(),\n",
    "            \"label\": y_val.astype(int).tolist(),\n",
    "        })\n",
    "\n",
    "        val_dataset = HFDataset.from_pandas(val_hf_df)\n",
    "        eval_tokenized = val_dataset.map(tokenize_batch, batched=True)\n",
    "        eval_tokenized = eval_tokenized.remove_columns([\"text\"])\n",
    "\n",
    "    # Dynamic padding pads each batch only to its longest sequence\n",
    "    data_collator = DataCollatorWithPadding(tokenizer=tokenizer)\n",
    "\n",
    "    def compute_metrics(eval_pred):\n",
    "        logits, labels = eval_pred\n",
    "        preds = np.argmax(logits, axis=1)\n",
    "\n",
    "        return {\n",
    "            \"accuracy\": accuracy_score(labels, preds),\n",
    "            \"precision\": precision_score(labels, preds, zero_division=0),\n",
    "            \"recall\": recall_score(labels, preds, zero_division=0),\n",
    "            \"f1\": f1_score(labels, preds, zero_division=0),\n",
    "        }\n",
    "\n",
    "    args = TrainingArguments(\n",
    "        output_dir=\"./bertweet_authorship_model\",\n",
    "        learning_rate=2e-5,\n",
    "        per_device_train_batch_size=16,\n",
    "        per_device_eval_batch_size=32,\n",
    "        num_train_epochs=epochs,\n",
    "        weight_decay=0.01,\n",
    "        logging_steps=25,\n",
    "        save_strategy=\"no\",\n",
    "        eval_strategy=\"epoch\" if eval_tokenized is not None else \"no\",\n",
    "        report_to=\"none\",\n",
    "        seed=SEED,\n",
    "    )\n",
    "\n",
    "    trainer = Trainer(\n",
    "        model=model,\n",
    "        args=args,\n",
    "        train_dataset=tokenized,\n",
    "        eval_dataset=eval_tokenized,\n",
    "        processing_class=tokenizer,\n",
    "        data_collator=data_collator,\n",
    "        compute_metrics=compute_metrics if eval_tokenized is not None else None,\n",
    "    )\n",
    "\n",
    "    trainer.train()\n",
    "\n",
    "    # Return a wrapper with a predict method, so it can be used like the sklearn models\n",
    "    return BertweetModelWrapper(tokenizer=tokenizer, model=model, device=device, max_length=max_length)\n",
    "\n",
    "\n",
    "def holdout_evaluate_bertweet(X: pd.DataFrame, y: np.ndarray, epochs: int = 3) -> Dict[str, float]:\n",
    "    \"\"\"Evaluate BERTweet on one stratified holdout split.\"\"\"\n",
    "    # I use a holdout split here to keep runtime reasonable\n",
    "    X_train, X_val, y_train, y_val = train_test_split(\n",
    "        X,\n",
    "        y,\n",
    "        test_size=0.2,\n",
    "        random_state=SEED,\n",
    "        stratify=y\n",
    "    )\n",
    "\n",
    "    # Fine-tune only on the training portion, then predict on validation\n",
    "    model = train_bertweet_model(\n",
    "        X_train.reset_index(drop=True),\n",
    "        y_train,\n",
    "        X_val.reset_index(drop=True),\n",
    "        y_val,\n",
    "        epochs=epochs\n",
    "    )\n",
    "    preds = model.predict(X_val.reset_index(drop=True))\n",
    "\n",
    "    print(\"BERTweet holdout validation\")\n",
    "    print(classification_report(y_val, preds, digits=4))\n",
    "\n",
    "    return {\n",
    "        \"model\": f\"BERTweet ({epochs} epochs)\",\n",
    "        \"accuracy_mean\": float(accuracy_score(y_val, preds)),\n",
    "        \"accuracy_std\": 0.0,\n",
    "        \"precision_mean\": float(precision_score(y_val, preds, zero_division=0)),\n",
    "        \"precision_std\": 0.0,\n",
    "        \"recall_mean\": float(recall_score(y_val, preds, zero_division=0)),\n",
    "        \"recall_std\": 0.0,\n",
    "        \"f1_mean\": float(f1_score(y_val, preds, zero_division=0)),\n",
    "        \"f1_std\": 0.0,\n",
    "    }\n",
    "\n",
    "\n",
    "def cross_validate_bertweet(X: pd.DataFrame, y: np.ndarray, epochs: int = 3, n_splits: int = 5) -> Dict[str, float]:\n",
    "    \"\"\"Evaluate BERTweet using stratified k-fold cross validation.\"\"\"\n",
    "    cv = StratifiedKFold(\n",
    "        n_splits=n_splits,\n",
    "        shuffle=True,\n",
    "        random_state=SEED\n",
    "    )\n",
    "\n",
    "    accuracy_scores = []\n",
    "    precision_scores = []\n",
    "    recall_scores = []\n",
    "    f1_scores = []\n",
    "\n",
    "    for fold_idx, (train_idx, val_idx) in enumerate(cv.split(X, y), start=1):\n",
    "        print(f\"\\nBERTweet fold {fold_idx}/{n_splits}\")\n",
    "\n",
    "        X_train = X.iloc[train_idx].reset_index(drop=True)\n",
    "        X_val = X.iloc[val_idx].reset_index(drop=True)\n",
    "\n",
    "        y_train = y[train_idx]\n",
    "        y_val = y[val_idx]\n",
    "\n",
    "        # Train a completely new BERTweet model for every fold for fair comparison to the other classifiers\n",
    "        model = train_bertweet_model(\n",
    "            X_train,\n",
    "            y_train,\n",
    "            X_val,\n",
    "            y_val,\n",
    "            epochs=epochs\n",
    "        )\n",
    "\n",
    "        preds = model.predict(X_val)\n",
    "\n",
    "        fold_accuracy = accuracy_score(y_val, preds)\n",
    "        fold_precision = precision_score(y_val, preds, zero_division=0)\n",
    "        fold_recall = recall_score(y_val, preds, zero_division=0)\n",
    "        fold_f1 = f1_score(y_val, preds, zero_division=0)\n",
    "\n",
    "        accuracy_scores.append(fold_accuracy)\n",
    "        precision_scores.append(fold_precision)\n",
    "        recall_scores.append(fold_recall)\n",
    "        f1_scores.append(fold_f1)\n",
    "\n",
    "        print(f\"Fold {fold_idx} results:\")\n",
    "        print(f\"Accuracy : {fold_accuracy:.4f}\")\n",
    "        print(f\"Precision: {fold_precision:.4f}\")\n",
    "        print(f\"Recall   : {fold_recall:.4f}\")\n",
    "        print(f\"F1       : {fold_f1:.4f}\")\n",
    "\n",
    "    return {\n",
    "        \"model\": f\"BERTweet ({epochs} epochs, {n_splits}-fold CV)\",\n",
    "        \"accuracy_mean\": float(np.mean(accuracy_scores)),\n",
    "        \"accuracy_std\": float(np.std(accuracy_scores)),\n",
    "        \"precision_mean\": float(np.mean(precision_scores)),\n",
    "        \"precision_std\": float(np.std(precision_scores)),\n",
    "        \"recall_mean\": float(np.mean(recall_scores)),\n",
    "        \"recall_std\": float(np.std(recall_scores)),\n",
    "        \"f1_mean\": float(np.mean(f1_scores)),\n",
    "        \"f1_std\": float(np.std(f1_scores)),\n",
    "    }"
   ]
  },
