    "def retrain_best_model(train_fn = None):\n",
    "  \"\"\" Retrains and returns the best performing model for the specified task. The\n",
    "      function uses the hard coded settings you have found to work best for each\n",
    "      of the tasks.\n",
    "\n",
    "      Args:\n",
    "          train_ fn (str): full path to the file containing the training data.\n",
    "  \"\"\"\n",
    "  # If no path is given, use the default training file name from the first cells\n",
    "  if train_fn is None:\n",
    "      train_fn = TRAIN_FILE\n",
    "\n",
    "  # Current default choice: BERTweet.\n",
    "  # I chose it as the final model because it achieved the highest mean F1 score and highest mean accuracy in the 5-fold cross-validation\n",
    "  best_alg = 6\n",
    "  m = training_pipeline(best_alg, train_fn)\n",
    "\n",
    "  return m"
   ]
  },
  {
   "cell_type": "code",
