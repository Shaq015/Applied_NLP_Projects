    "class FFNNClassifier(nn.Module):\n",
    "    \"\"\"A simple feed-forward neural network with three hidden layers.\"\"\"\n",
    "\n",
    "    def __init__(self, input_dim: int, hidden1: int = 512, hidden2: int = 256, hidden3: int = 128, dropout: float = 0.30):\n",
    "        super().__init__()\n",
    "\n",
    "        # The network receives a dense TF-IDF vector as input. I chose to use 3 hidden layers\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(input_dim, hidden1),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(dropout),       # Dropout to help reduce overfitting on a small dataset\n",
    "\n",
    "            nn.Linear(hidden1, hidden2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(dropout),\n",
    "\n",
    "            nn.Linear(hidden2, hidden3),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(dropout),\n",
    "\n",
    "            # Binary classification output: one logit per tweet\n",
    "            nn.Linear(hidden3, 1),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.net(x).squeeze(1)\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class FFNNModelWrapper:\n",
    "    \"\"\"Small wrapper so the PyTorch FFNN behaves like sklearn models for prediction.\"\"\"\n",
    "    vectorizer: TfidfVectorizer\n",
    "    model: FFNNClassifier\n",
    "    device: torch.device\n",
    "\n",
    "    def predict(self, X: pd.DataFrame) -> np.ndarray:\n",
    "        # Use the same TF-IDF vectorizer that was fitted during training\n",
    "        texts = X[\"clean_text\"].astype(str).tolist()\n",
    "        X_vec = self.vectorizer.transform(texts).astype(np.float32)\n",
    "\n",
    "        # For simplicity, convert the sparse matrix to dense before sending to PyTorch\n",
    "        tensor = torch.tensor(X_vec.toarray(), dtype=torch.float32).to(self.device)\n",
    "\n",
    "        self.model.to(self.device)\n",
    "        self.model.eval()\n",
    "\n",
    "        with torch.no_grad():\n",
    "            logits = self.model(tensor)\n",
    "            probs = torch.sigmoid(logits)        # convert logits to probabilities\n",
    "            preds = (probs >= 0.5).long().cpu().numpy()\n",
    "\n",
    "        return preds.astype(int)\n",
    "\n",
    "\n",
    "\n",
    "def train_ffnn_model(X: pd.DataFrame, y: np.ndarray, epochs: int = 8, batch_size: int = 32) -> FFNNModelWrapper:\n",
    "    \"\"\"Train the FFNN on TF-IDF vectors.\"\"\"\n",
    "    # I used fewer max_features than some sklearn models to keep dense tensors manageable\n",
    "    vectorizer = TfidfVectorizer(\n",
    "        ngram_range=(1, 2),\n",
    "        min_df=2,\n",
    "        max_features=7000,\n",
    "        sublinear_tf=True\n",
    "    )\n",
    "\n",
    "    # Fit vectorizer only on the training split passed into this function\n",
    "    X_vec = vectorizer.fit_transform(X[\"clean_text\"].astype(str).tolist()).astype(np.float32)\n",
    "    y_arr = y.astype(np.float32)\n",
    "\n",
    "    X_tensor = torch.tensor(X_vec.toarray(), dtype=torch.float32)\n",
    "    y_tensor = torch.tensor(y_arr, dtype=torch.float32)\n",
    "\n",
    "    loader = DataLoader(\n",
    "        TensorDataset(X_tensor, y_tensor),\n",
    "        batch_size=batch_size,\n",
    "        shuffle=True    # Important so each epoch sees the examples in a different order\n",
    "    )\n",
    "\n",
    "    model = FFNNClassifier(input_dim=X_vec.shape[1]).to(device)\n",
    "    criterion = nn.BCEWithLogitsLoss()                      # binary classification loss\n",
    "    optimizer = optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-4)\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        total_loss = 0.0\n",
    "\n",
    "        for xb, yb in loader:\n",
    "            xb = xb.to(device)\n",
    "            yb = yb.to(device)\n",
    "            optimizer.zero_grad()\n",
    "            logits = model(xb)\n",
    "            loss = criterion(logits, yb)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            total_loss += loss.item()\n",
    "\n",
    "        print(f\"FFNN epoch {epoch + 1}/{epochs} - loss: {total_loss / max(len(loader), 1):.4f}\")\n",
    "\n",
    "    return FFNNModelWrapper(vectorizer=vectorizer, model=model, device=device)\n",
    "\n",
    "\n",
    "def cross_validate_ffnn(X: pd.DataFrame, y: np.ndarray, epochs: int = 5) -> Dict[str, float]:\n",
    "    \"\"\"Evaluate the FFNN with the same StratifiedKFold idea as the other models.\"\"\"\n",
    "    accs, precs, recs, f1s = [], [], [], []\n",
    "\n",
    "    # Manual CV is used because the FFNN is not a native sklearn estimator\n",
    "    for fold_idx, (train_idx, val_idx) in enumerate(get_cv().split(X, y), start=1):\n",
    "        print(f\"\\nFFNN fold {fold_idx}\")\n",
    "\n",
    "        # Split by indices from the shared StratifiedKFold object\n",
    "        X_train = X.iloc[train_idx].reset_index(drop=True)\n",
    "        X_val = X.iloc[val_idx].reset_index(drop=True)\n",
    "        y_train, y_val = y[train_idx], y[val_idx]\n",
    "\n",
    "        # Train a fresh neural network for this fold\n",
    "        model = train_ffnn_model(X_train, y_train, epochs=epochs)\n",
    "        preds = model.predict(X_val)\n",
    "\n",
    "        # Save fold metrics\n",
    "        accs.append(accuracy_score(y_val, preds))\n",
    "        precs.append(precision_score(y_val, preds, zero_division=0))\n",
    "        recs.append(recall_score(y_val, preds, zero_division=0))\n",
    "        f1s.append(f1_score(y_val, preds, zero_division=0))\n",
    "\n",
    "    return {\n",
    "        \"model\": \"PyTorch FFNN\",\n",
    "        \"accuracy_mean\": float(np.mean(accs)),\n",
    "        \"accuracy_std\": float(np.std(accs)),\n",
    "        \"precision_mean\": float(np.mean(precs)),\n",
    "        \"precision_std\": float(np.std(precs)),\n",
    "        \"recall_mean\": float(np.mean(recs)),\n",
    "        \"recall_std\": float(np.std(recs)),\n",
    "        \"f1_mean\": float(np.mean(f1s)),\n",
    "        \"f1_std\": float(np.std(f1s)),\n",
    "    }"
   ]
  },
